# ============================================================
#  .gitignore — AI Attendance System
# ============================================================

# ── Secrets (NEVER commit these) ─────────────────────────────────────────────
.env
credentials.json
token.json
service_account.json

# ── Student Data (personal data — keep local only) ────────────────────────────
known face photos/
known face encodings/
captured/
data/
config/cameras.json
config/institution.json
src/aas/core/*.json

# ── Vosk Voice Model (large binary, download separately) ──────────────────────
vosk-model-*/

# ── Python Cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environment ───────────────────────────────────────────────────────
venv/
env/
.venv/
.env/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# ── SQLite Database ───────────────────────────────────────────────────────────
*.db
*.db-wal
*.db-shm

# ── Pickle / Binary encodings ─────────────────────────────────────────────────
*.pkl
*.pickle

# ── Log files ─────────────────────────────────────────────────────────────────
*.log
logs/
