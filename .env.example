# ============================================================
#  .env.example — AI Attendance System
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit ".env" or "credentials.json" to git.
# ============================================================

# ── Gmail (use an App Password, NOT your real account password) ──────────────
# To generate an App Password:
#   1. Go to myaccount.google.com → Security → 2-Step Verification → App passwords
#   2. Select "Mail" and your device → Generate
#   3. Paste the 16-character code below (spaces are OK)
GMAIL_SENDER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Exact name of the Google Sheet (must be shared with your service account email)
SHEET_NAME=Face recognition

# ── Camera ────────────────────────────────────────────────────────────────────
# Leave blank to use the local webcam (index 0)
# For a fixed IP/RTSP classroom camera, set the full RTSP URL:
#   IP_CAMERA_URL=rtsp://admin:yourpassword@192.168.1.50:554/stream
IP_CAMERA_URL=

# Webcam index (only used if IP_CAMERA_URL is blank)
WEBCAM_INDEX=0

# ── Recognition Tuning ────────────────────────────────────────────────────────
# 0.55 = slightly strict (recommended for classrooms)
# 0.60 = dlib default (more lenient)
# 0.50 = very strict (may miss students at back of room)
RECOGNITION_TOLERANCE=0.55

# Scale factor for image before recognition (0.25 = quarter size, fastest)
# Increase to 0.5 if back-row faces are being missed
RECOGNITION_SCALE=0.25

# ── Attendance Rules ──────────────────────────────────────────────────────────
# Students arriving after this time will be marked 'late'
MAX_IN_TIME=16:00:00

# ── Voice Trigger ─────────────────────────────────────────────────────────────
# The spoken phrase that triggers camera capture (case-insensitive)
VOICE_TRIGGER_PHRASE=take attendance

# ── Web Dashboard ─────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=5000
